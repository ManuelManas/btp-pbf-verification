'BTP.Toeplitz.manuscript_negative_roots_to_PBF' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem BTP.Toeplitz.manuscript_theorem_3_2_given_Edrei : EdreiPolynomialInput →
  ∀ {p q : ℕ} (D : ToeplitzData p q),
    (TN D.matrix ↔ StrictBandTP p q D.matrix) ∧
      (TN D.matrix ↔ NegativeRoots D.polynomial) ∧
        (TN D.matrix ↔ MatrixPBF p q D.matrix) ∧ (TN D.matrix ↔ MatrixBoundedPBF p q D.matrix) :=
fun hEdrei {p q} D =>
  have h :=
    theorem_3_2_given_Edrei hEdrei p q D.polynomial (ToeplitzData.polynomial_degree D)
      (ToeplitzData.polynomial_zero_pos D);
  ⟨(Eq.mp
        (congrArg
          (fun _a =>
            (TN _a ↔ StrictBandTP p q _a) ∧
              (TN _a ↔ NegativeRoots D.polynomial) ∧
                (TN _a ↔ HasPBF p q (symbolOperator q D.polynomial)) ∧
                  (TN _a ↔ HasBoundedPBF p q (symbolOperator q D.polynomial)))
          (ToeplitzData.symbol_matrix D))
        h).left,
    ⟨(Eq.mp
            (congrArg
              (fun _a =>
                (TN _a ↔ StrictBandTP p q _a) ∧
                  (TN _a ↔ NegativeRoots D.polynomial) ∧
                    (TN _a ↔ HasPBF p q (symbolOperator q D.polynomial)) ∧
                      (TN _a ↔ HasBoundedPBF p q (symbolOperator q D.polynomial)))
              (ToeplitzData.symbol_matrix D))
            h).right.left,
      ⟨{
          mp := fun ht =>
            matrixBoundedPBF_implies_PBF
              (manuscript_negative_roots_to_PBF D
                  ((Eq.mp
                            (congrArg
                              (fun _a =>
                                (TN _a ↔ StrictBandTP p q _a) ∧
                                  (TN _a ↔ NegativeRoots D.polynomial) ∧
                                    (TN _a ↔ HasPBF p q (symbolOperator q D.polynomial)) ∧
                                      (TN _a ↔ HasBoundedPBF p q (symbolOperator q D.polynomial)))
                              (ToeplitzData.symbol_matrix D))
                            h).right.left.mp
                    fun {k} => ht)).left,
          mpr := matrixPBF_implies_TN },
        {
          mp := fun ht =>
            (manuscript_negative_roots_to_PBF D
                ((Eq.mp
                          (congrArg
                            (fun _a =>
                              (TN _a ↔ StrictBandTP p q _a) ∧
                                (TN _a ↔ NegativeRoots D.polynomial) ∧
                                  (TN _a ↔ HasPBF p q (symbolOperator q D.polynomial)) ∧
                                    (TN _a ↔ HasBoundedPBF p q (symbolOperator q D.polynomial)))
                            (ToeplitzData.symbol_matrix D))
                          h).right.left.mp
                  fun {k} => ht)).left,
          mpr := fun hb {k} => matrixPBF_implies_TN (matrixBoundedPBF_implies_PBF hb) }⟩⟩⟩
