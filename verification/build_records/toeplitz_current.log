'BTP.Toeplitz.negative_roots_to_global_PBF' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem BTP.Toeplitz.theorem_3_2_given_Edrei : EdreiPolynomialInput →
  ∀ (p q : ℕ) (P : Polynomial ℝ),
    P.natDegree = p + q →
      0 < P.coeff 0 →
        (TN (symbolMatrix q P) ↔ StrictBandTP p q (symbolMatrix q P)) ∧
          (TN (symbolMatrix q P) ↔ NegativeRoots P) ∧
            (TN (symbolMatrix q P) ↔ HasPBF p q (symbolOperator q P)) ∧
              (TN (symbolMatrix q P) ↔ HasBoundedPBF p q (symbolOperator q P)) :=
fun hEdrei p q P hdeg hzero =>
  have htroot := fun ht => hEdrei P hzero fun {k} => (symbolMatrix_TN_iff_shift_zero q P).mp fun {k} => ht;
  have hrt := negative_roots_to_global_PBF p q P hdeg hzero;
  have hband := symbolMatrix_band p q P (Eq.le hdeg);
  ⟨{ mp := fun ht {k} => (hrt (htroot fun {k} => ht)).right.right.left,
      mpr := fun ht {k} => ((BandedTP_iff_strict hband).mpr fun {k} => ht).left },
    ⟨{ mp := htroot, mpr := fun hr {k} => (hrt hr).right.right.right },
      ⟨{ mp := fun ht => (hrt (htroot fun {k} => ht)).right.left,
          mpr := fun hp =>
            have ht := fun {k} => PBF_implies_TN hp;
            @Eq.mp (TN (opMatrix (symbolOperator q P))) (TN (symbolMatrix q P))
              (congrArg (fun _a => TN _a) (symbolOperator_matrix q P)) ht },
        { mp := fun ht => (hrt (htroot fun {k} => ht)).left,
          mpr := fun hb =>
            have ht := fun {k} => PBF_implies_TN (HasBoundedPBF.hasPBF hb);
            @Eq.mp (TN (opMatrix (symbolOperator q P))) (TN (symbolMatrix q P))
              (congrArg (fun _a => TN _a) (symbolOperator_matrix q P)) ht }⟩⟩⟩
