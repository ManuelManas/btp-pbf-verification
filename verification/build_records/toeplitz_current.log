Checking BTPToPBF.lean
theorem BTP.Toeplitz.manuscript_BTP_to_PBF : ∀ {p q : ℕ} (D : ToeplitzData p q),
  0 < p + q → StrictBandTP p q D.matrix → MatrixBoundedPBF p q D.matrix :=
fun {p q} D hpq hBTP =>
  have ht :=
    @Eq.mpr (StrictBandTP p q (symbolMatrix q D.polynomial)) (StrictBandTP p q D.matrix)
      (id (congrArg (fun _a => StrictBandTP p q _a) (ToeplitzData.symbol_matrix D))) hBTP;
  Exists.intro (symbolOperator q D.polynomial)
    ⟨BTP_implies_global_bounded_PBF p q hpq D.polynomial (Eq.le (ToeplitzData.polynomial_degree D))
        (ToeplitzData.polynomial_zero_pos D) fun {k} => ht,
      Eq.mpr (id (congrArg (fun _a => _a = D.matrix) (symbolOperator_matrix q D.polynomial)))
        (Eq.mpr (id (congrArg (fun _a => _a = D.matrix) (ToeplitzData.symbol_matrix D))) (Eq.refl D.matrix))⟩
