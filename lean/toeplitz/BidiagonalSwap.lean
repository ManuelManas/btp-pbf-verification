import Mathlib.Analysis.Matrix.Normed
import Mathlib.Tactic

/-!
# Positive semi-infinite upper/lower exchange

The operators act on all real sequences. Every output coordinate uses only
finitely many input coordinates, so composition is the actual semi-infinite
matrix product, without a choice of finite-section boundary conditions.
Lower-factor entries at index zero are unused.
-/

open scoped BigOperators
noncomputable section
namespace BTP.Toeplitz

set_option linter.unnecessarySeqFocus false

abbrev Seq := ℕ → ℝ
abbrev Op := Module.End ℝ Seq

/-- Uniform upper and strictly positive lower bounds. -/
def BoundedPositive (a : Seq) : Prop :=
  ∃ l h : ℝ, 0 < l ∧ ∀ n, l ≤ a n ∧ a n ≤ h

theorem BoundedPositive.pos {a : Seq} (ha : BoundedPositive a) (n : ℕ) : 0 < a n := by
  obtain ⟨l, h, hl, ha⟩ := ha
  exact hl.trans_le (ha n).1

theorem boundedPositive_const {a : ℝ} (ha : 0 < a) : BoundedPositive (fun _ => a) :=
  ⟨a, a, ha, fun _ => ⟨le_rfl, le_rfl⟩⟩

theorem BoundedPositive.mul {a b : Seq} (ha : BoundedPositive a)
    (hb : BoundedPositive b) : BoundedPositive (fun n => a n * b n) := by
  obtain ⟨al, ah, hal, ha⟩ := ha
  obtain ⟨bl, bh, hbl, hb⟩ := hb
  refine ⟨al * bl, ah * bh, mul_pos hal hbl, fun n => ⟨?_, ?_⟩⟩
  · exact mul_le_mul (ha n).1 (hb n).1 hbl.le (hal.le.trans (ha n).1)
  · exact mul_le_mul (ha n).2 (hb n).2 (hbl.le.trans (hb n).1)
      ((hal.le.trans (ha n).1).trans (ha n).2)

theorem BoundedPositive.div {a b : Seq} (ha : BoundedPositive a)
    (hb : BoundedPositive b) : BoundedPositive (fun n => a n / b n) := by
  obtain ⟨al, ah, hal, ha⟩ := ha
  obtain ⟨bl, bh, hbl, hb⟩ := hb
  have hbh : 0 < bh := hbl.trans_le ((hb 0).1.trans (hb 0).2)
  refine ⟨al / bh, ah / bl, div_pos hal hbh, fun n => ⟨?_, ?_⟩⟩
  · exact div_le_div₀ (hal.le.trans (ha n).1) (ha n).1 (hbl.trans_le (hb n).1) (hb n).2
  · exact div_le_div₀ ((hal.le.trans (ha n).1).trans (ha n).2) (ha n).2 hbl (hb n).1

theorem BoundedPositive.comp {a : Seq} (ha : BoundedPositive a) (f : ℕ → ℕ) :
    BoundedPositive (a ∘ f) := by
  obtain ⟨l, h, hl, ha⟩ := ha
  exact ⟨l, h, hl, fun n => ha (f n)⟩

def diagonal (d : Seq) : Op where
  toFun x n := d n * x n
  map_add' x y := by ext n; simp only [Pi.add_apply]; ring
  map_smul' c x := by ext n; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

def lower (a : Seq) : Op where
  toFun x n := x n + if n = 0 then 0 else a n * x (n - 1)
  map_add' x y := by ext n; by_cases hn : n = 0 <;> simp [hn] <;> ring
  map_smul' c x := by ext n; by_cases hn : n = 0 <;> simp [hn] <;> ring

/-- Upper bidiagonal with prescribed diagonal and unit superdiagonal. -/
def upper (u : Seq) : Op where
  toFun x n := u n * x n + x (n + 1)
  map_add' x y := by ext n; simp only [Pi.add_apply]; ring
  map_smul' c x := by ext n; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

/-- Unit upper bidiagonal with prescribed superdiagonal. -/
def unitUpper (b : Seq) : Op where
  toFun x n := x n + b n * x (n + 1)
  map_add' x y := by ext n; simp only [Pi.add_apply]; ring
  map_smul' c x := by ext n; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

@[simp] theorem diagonal_apply (d x : Seq) (n : ℕ) : diagonal d x n = d n * x n := rfl
@[simp] theorem upper_apply (u x : Seq) (n : ℕ) : upper u x n = u n * x n + x (n+1) := rfl
@[simp] theorem unitUpper_apply (u x : Seq) (n : ℕ) :
    unitUpper u x n = x n + u n * x (n+1) := rfl
@[simp] theorem lower_zero (a x : Seq) : lower a x 0 = x 0 := by simp [lower]
@[simp] theorem lower_succ (a x : Seq) (n : ℕ) :
    lower a x (n+1) = x (n+1) + a (n+1) * x n := by simp [lower]

/-- The diagonal generated by the manuscript's exchange recurrence. -/
def exchangeDiag (u a : Seq) : Seq
  | 0 => u 0 + a 1
  | n+1 => u (n+1) + a (n+2) - u (n+1) * a (n+1) / exchangeDiag u a n

theorem exchangeDiag_bounds (u a : Seq) (hu : ∀ n, 0 < u n) (ha : ∀ n, 0 < a n) :
    ∀ n, a (n+1) < exchangeDiag u a n ∧ exchangeDiag u a n ≤ u n + a (n+1) := by
  intro n
  induction n with
  | zero => simp only [exchangeDiag]; constructor <;> linarith [hu 0]
  | succ n ih =>
    have hd : 0 < exchangeDiag u a n := (ha (n+1)).trans ih.1
    have hquot : 0 < u (n+1) * a (n+1) / exchangeDiag u a n :=
      div_pos (mul_pos (hu _) (ha _)) hd
    have hlt : u (n+1) * a (n+1) / exchangeDiag u a n < u (n+1) := by
      apply (div_lt_iff₀ hd).mpr
      exact mul_lt_mul_of_pos_left ih.1 (hu _)
    simp only [exchangeDiag]
    constructor <;> linarith

theorem exchangeDiag_boundedPositive {u a : Seq} (hu : BoundedPositive u)
    (ha : BoundedPositive a) : BoundedPositive (exchangeDiag u a) := by
  have hb := exchangeDiag_bounds u a hu.pos ha.pos
  obtain ⟨ul, uh, hul, hu⟩ := hu
  obtain ⟨al, ah, hal, ha⟩ := ha
  exact ⟨al, uh + ah, hal, fun n =>
    ⟨(ha (n+1)).1.trans (hb n).1.le, (hb n).2.trans (add_le_add (hu n).2 (ha (n+1)).2)⟩⟩

def exchangeLower (u a : Seq) : Seq :=
  fun n => u n * a n / exchangeDiag u a (n-1)

theorem exchangeLower_boundedPositive {u a : Seq} (hu : BoundedPositive u)
    (ha : BoundedPositive a) : BoundedPositive (exchangeLower u a) :=
  (hu.mul ha).div ((exchangeDiag_boundedPositive hu ha).comp (fun n => n-1))

/-- One exchange, including the row at the left boundary. -/
theorem upper_lower_exchange (u a : Seq) (hu : ∀ n, 0 < u n) (ha : ∀ n, 0 < a n) :
    upper u * lower a = lower (exchangeLower u a) * upper (exchangeDiag u a) := by
  have hd : ∀ n, exchangeDiag u a n ≠ 0 :=
    fun n => ((ha (n+1)).trans (exchangeDiag_bounds u a hu ha n).1).ne'
  ext x n
  change upper u (lower a x) n = lower (exchangeLower u a) (upper (exchangeDiag u a) x) n
  cases n with
  | zero => simp [exchangeDiag]; ring
  | succ n =>
    simp only [upper_apply, lower_succ, exchangeLower, Nat.add_sub_cancel]
    rw [show exchangeDiag u a (n+1) = u (n+1) + a (n+2) -
      u (n+1) * a (n+1) / exchangeDiag u a n from rfl]
    field_simp [hd n]
    <;> ring

/-- A bounded positive exchange preserves uniform separation from zero. -/
theorem bounded_positive_exchange {u a : Seq} (hu : BoundedPositive u)
    (ha : BoundedPositive a) :
    ∃ b d : Seq, BoundedPositive b ∧ BoundedPositive d ∧
      upper u * lower a = lower b * upper d :=
  ⟨exchangeLower u a, exchangeDiag u a, exchangeLower_boundedPositive hu ha,
    exchangeDiag_boundedPositive hu ha, upper_lower_exchange u a hu.pos ha.pos⟩

#print axioms upper_lower_exchange
#print axioms bounded_positive_exchange
end BTP.Toeplitz
